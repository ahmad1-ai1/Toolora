{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/google63909bce1f342ce4\\.html$",
      "headers": {
        "Content-Type": "text/html; charset=utf-8",
        "Cache-Control": "public, max-age=0, must-revalidate",
        "X-Robots-Tag": "all"
      },
      "dest": "/google63909bce1f342ce4.html",
      "continue": false
    },
    {
      "src": "^/robots\\.txt$",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8"
      },
      "dest": "/robots.txt",
      "continue": false
    },
    {
      "src": "^/sitemap\\.xml$",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8"
      },
      "dest": "/sitemap.xml",
      "continue": false
    },
    {
      "src": "^/favicon\\.svg$",
      "dest": "/favicon.svg",
      "continue": false
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
